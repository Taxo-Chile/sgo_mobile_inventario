# Plantilla para android/keystore.properties
#
# Copiar este archivo como `keystore.properties` (sin .example) y completar con
# los datos reales. Ese archivo y el .jks están en .gitignore: NUNCA se
# commitean.
#
# Crear la llave, una sola vez para todo el proyecto:
#
#   keytool -genkeypair -v -keystore sgo-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias sgo
#
# ADVERTENCIA — LLAVE TEMPORAL
#
# La que se crea con ese keytool es una llave TEMPORAL. Sirve para salir y
# probar, pero no es la definitiva: la app va a publicarse con el keystore de
# Taxo, que maneja el equipo que mantiene sodimac.
#
# Mientras exista la app instalada con la llave temporal, NO se puede cambiar a
# otra: Android exige que la firma coincida para actualizar, y con firma distinta
# la APK de actualización se rechaza sin motivo visible. Por eso la temporal se
# conserva siempre: con ella se rota a la llave definitiva de una sola vez,
# usando el certificado de la temporal como lineage:
#
#   apksigner sign --ks Taxo.jks --ks-key-alias taxo --out nuevo.apk \
#     --lineage actual.jks --lineage-key-alias sgo actual.apk
#
# Sin la temporal guardada, esa rotación es imposible y cada cambio de firma
# obligaría a desinstalar la app en cada tablet, borrando lo que no se haya
# sincronizado.
#
# Guardala fuera del repositorio, con respaldo, y que la conozca más de una
# persona del equipo.

# Ruta al .jks, relativa a la carpeta android/ o absoluta.
storeFile=../sgo-release.jks

storePassword=CAMBIAR
keyAlias=sgo
keyPassword=CAMBIAR
